# HuggingFace token (needed for the embedding model and, by default, for the
# LLM via LiteLLM's huggingface/ provider — see LLM_MODEL below).
HF_TOKEN=

# Optional: LangSmith tracing (LangGraph picks these up automatically if set).
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT='https://api.smith.langchain.com'
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=edullm

# --- Edu LLM backend ---
# Docker's postgres service maps to host port 5433 (see docker-compose.yml) to
# avoid clashing with a local system postgres on 5432, if you have one.
DATABASE_URL=postgresql://edullm:edullm@localhost:5433/edullm

# Dev-only HMAC secret for minting/verifying JWTs until the real auth
# service is live. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256

# LLM served via LiteLLM's huggingface/ provider prefix; reuses HF_TOKEN above.
# Swap this for any LiteLLM-supported model string (openai/..., anthropic/...)
# to change providers without touching code. Which HF-routed provider hosts
# a given model rotates over time — check before relying on this default:
# https://huggingface.co/api/models/<org>/<model>?expand[]=inferenceProviderMapping
LLM_MODEL=huggingface/featherless-ai/Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=sentence-transformers/multi-qa-mpnet-base-dot-v1

STORAGE_DIR=./backend/storage
CHUNK_SIZE=4000
CHUNK_OVERLAP=800
TOP_K=5

# --- Edu LLM magic-link login (Phase 2) ---
# Emails are sent via Resend's HTTP API (https://resend.com/api-keys).
# If RESEND_API_KEY is left blank, magic links are logged to the backend
# console instead of emailed, so local dev works with no email setup at all.
RESEND_API_KEY=
# onboarding@resend.dev works out of the box but can only deliver to the
# email address on your own Resend account. Verify a custom domain in
# Resend (https://resend.com/domains) to send to arbitrary recipients.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Edu LLM

# Must match wherever the frontend's /auth/verify route is actually served.
MAGIC_LINK_BASE_URL=http://localhost:5173/auth/verify
LOGIN_TOKEN_EXPIRY_MINUTES=15
SESSION_JWT_EXPIRY_DAYS=7

# Dev-only: comma-separated non-institute emails to log in as faculty,
# bypassing the @scet.ac.in domain check. Leave empty outside local dev.
DEV_FACULTY_EMAILS=

# --- Edu LLM frontend (Vite dev server) ---
VITE_API_BASE_URL=http://localhost:8000
